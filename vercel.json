{
  "functions": {
    "api/link-preview.ts": {
      "includeFiles": "dist/index.html"
    },
    "api/link-preview-image.ts": {
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/app-version\\.json",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      },
      "continue": true
    },
    {
      "src": "/sw\\.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/registerSW\\.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^/$",
      "dest": "/api/link-preview?previewPath=/"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/link-preview?previewPath=/$1"
    }
  ]
}
